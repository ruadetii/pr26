<Window x:Class="pr26_Radosteva.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pr26_Radosteva"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button 
            Click="Clubs"
            Content="Клубы"
            Height="25"
            Width="100"
            VerticalAlignment="Top"
            HorizontalAlignment="Left"
            Margin="10,10,0,0"
            Background="#FF46FD00" 
            BorderBrush="#FF46FD00" 
            Foreground="White"/>
        <Button 
            Click="Users"
            Content="Пользователи"
            Height="25"
            Width="100"
            VerticalAlignment="Top"
            HorizontalAlignment="Left"
            Margin="115,10,0,0"
            Background="#FF46FD00" 
            BorderBrush="#FF46FD00" 
            Foreground="White"/>
        <Frame x:Name="frame" NavigationUIVisibility="Hidden" Margin="0,40,0,0"/>
    </Grid>
</Window>
